{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git submodule update --init --recursive >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 300,
            "statusMessage": "Initializing submodules..."
          }
        ]
      }
    ]
  }
}
