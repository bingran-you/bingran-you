{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-skills-data.mjs && next dev",
    "build": "npm run palace:build && next build",
    "start": "next start",
    "lint": "eslint",
    "skills:generate": "node scripts/generate-skills-data.mjs",
    "post:add": "node scripts/add-post.mjs",
